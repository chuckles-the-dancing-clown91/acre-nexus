# Base URL of the Rust API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Tenant slug used by the public demo website.
NEXT_PUBLIC_DEFAULT_TENANT=northwind

# Branding follows the host. Vantedge's own hosts (and localhost) show the
# Vantedge brand; a client's verified domain shows the client's.
# Comma-separated hosts that serve the Vantedge console (server-side, runtime):
# PLATFORM_HOSTS=app.vantedge.com
# Local only: preview the console as a client's branded domain would show it.
# BRANDED_TENANT_PREVIEW=northwind

# Build-time: list the seeded demo accounts (password "password") on the login
# page. Development/demo builds only — leave unset for production (default: hidden).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=1
